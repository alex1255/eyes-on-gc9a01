[Unit]
Description=Uncanny Eyes on GC9A01
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/opt/uncanny-eyes
ExecStart=/usr/bin/python3 /opt/uncanny-eyes/eyes.py
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1
Environment=OPENBLAS_NUM_THREADS=1
UMask=0027

[Install]
WantedBy=multi-user.target
